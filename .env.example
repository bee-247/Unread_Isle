# 使用方法：
#   1. cp .env.example .env
#   2. 将所有 CHANGE_ME 替换为真实值
#   3. 不要提交 .env

COMPOSE_PROJECT_NAME=unread_isle
TZ=Asia/Shanghai

# -------------------- Docker 镜像版本 --------------------
MYSQL_VERSION=8.4.8
REDIS_VERSION=7.4.10-alpine
KAFKA_VERSION=3.9.1
ELASTICSEARCH_VERSION=9.2.1
CANAL_VERSION=v1.1.8
# Apple Silicon 可保留 linux/amd64 让 Canal 通过模拟运行。
CANAL_PLATFORM=linux/amd64

# -------------------- MySQL --------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unread_isle
MYSQL_USERNAME=unread_isle
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# -------------------- Redis --------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DATABASE=0

# -------------------- Kafka --------------------
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# 单机开发集群 ID。仅在清空 Kafka 数据卷并重建集群时更换。
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# -------------------- Elasticsearch --------------------
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://127.0.0.1:9200
# 本地 Compose 关闭了 ES 安全认证，因此默认留空。
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ES_JAVA_OPTS="-Xms1g -Xmx1g"
ES_CONTENT_INDEX=unread_isle_content_index
ES_VECTOR_INDEX=unread_isle_ai_index

# 必须与所选 Embedding 模型的输出维度一致。
EMBEDDING_DIMENSIONS=1536

# -------------------- Canal --------------------
CANAL_ENABLED=true
CANAL_HOST=127.0.0.1
CANAL_PORT=11111
CANAL_DESTINATION=example
CANAL_USERNAME=
CANAL_PASSWORD=
CANAL_FILTER=unread_isle.outbox
# 传给 Canal Server 的正则表达式。
CANAL_FILTER_REGEX=unread_isle\\.outbox
CANAL_BATCH_SIZE=100
CANAL_INTERVAL_MS=1000

# -------------------- DeepSeek 对话模型 --------------------
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# -------------------- Embedding 模型 --------------------
# 默认按 OpenAI 兼容接口配置。若使用其他供应商，请同时修改
# OPENAI_BASE_URL、EMBEDDING_MODEL 和 EMBEDDING_DIMENSIONS。
OPENAI_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
OPENAI_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# -------------------- 阿里云 OSS --------------------
# endpoint 示例：oss-cn-beijing.aliyuncs.com（不要带 bucket 名）
OSS_ENDPOINT=CHANGE_ME_OSS_ENDPOINT
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_KEY_SECRET
OSS_BUCKET=CHANGE_ME_OSS_BUCKET
# 可填写 CDN/自定义域名；不用时留空。
OSS_PUBLIC_DOMAIN=
OSS_FOLDER=avatars

# -------------------- 后端 --------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=8088
JWT_ISSUER=Unread_Isle
JWT_KEY_ID=unread_isle-local-key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_PRIVATE_KEY=file:./.secrets/jwt/private.pem
JWT_PUBLIC_KEY=file:./.secrets/jwt/public.pem

# -------------------- 前端（生产或直连后端时使用） --------------------
# 本地 npm run dev 已由 Vite 代理 /api，可保持为空。
VITE_API_BASE_URL=
